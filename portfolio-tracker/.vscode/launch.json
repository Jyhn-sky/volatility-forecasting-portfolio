{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dashboard (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Terminal report",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/report.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Terminal report + save CSVs",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/report.py",
      "args": ["--save"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
